# Shared environment template. Never commit real values in .env files.

# API / PostgreSQL (required from T04 onward; copy API values to api/.env)
# DATABASE_URL=
# TEST_DATABASE_URL=
# DB_POOL_MAX=10

# Better Auth (required from T06 onward; copy API values to api/.env)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:5173
# JUDGE_INVITATION_TTL_HOURS=72

# El cliente usa rutas /api relativas y el proxy de Vite en desarrollo.

# Production-only one-time administrator bootstrap (T09)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Development/test ADMIN seed (T10; never use in production)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=
