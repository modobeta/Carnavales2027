# Copiar como .env solo para desarrollo local. Nunca versionar valores reales.

DATABASE_URL=
TEST_DATABASE_URL=
DB_POOL_MAX=10

# Acceso local directo a Node: ignorar X-Forwarded-For.
# Producción: indicar los proxies confiables reales (ver README).
TRUST_PROXY=0

# Better Auth (required from T06 onward)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
JUDGE_INVITATION_TTL_HOURS=72
# OTP 2FA: en desarrollo se imprime por consola; en producción exige smtp o gmail
# (el código llega con plantilla HTML corporativa).
EMAIL_PROVIDER=console
# Si se habilita EMAIL_PROVIDER=smtp:
# EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Production-only one-time administrator bootstrap (T09)
# Execute only after `npm run auth:migrate` and `npm run db:migrate`.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Seed integral único: npm run seed:event:full (solo development/test)
# Identidad del ADMIN del fixture:
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=

# Contraseña común del evento integral (ADMIN + 9 jurados + ESCRIBANO + VEEDOR).
# Si se omite, usa SEED_ADMIN_PASSWORD. Entre 8 y 128 caracteres.
# Configurar el valor únicamente en .env local; nunca se imprime.
# SEED_DEMO_PASSWORD=

# Piloto Render: EMAIL_PROVIDER=gmail; EMAIL_FROM es la cuenta Gmail autorizada.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Produccion: DATABASE_URL de Neon con sslmode=require, DB_POOL_MAX=5.
# BETTER_AUTH_URL y FRONTEND_URL deben ser el mismo origen HTTPS.
